      "ensemble_aggregation": "annealed probability-weighted return curve before fitting; quenched per-history summaries must also be reported in production",
      "isolated_vertex_rule": "an isolated vertex is an absorbing one-vertex component",
      "component_reporting": "connected-component sizes and finite-size saturation must be reported",
      "candidate_evidence": true
    }
