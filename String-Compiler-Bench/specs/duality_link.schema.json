{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stringbench/duality_link.schema.json",
  "title": "DualityLinkCertificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate_id",
    "source_frame",
    "target_frame",
    "forward_map",
    "inverse_map",
    "validity_domain",
    "preserved_invariants",
    "transformed_quantities",
    "frame_specific_quantities",
    "discarded_information",
    "reconstructible_information",
    "known_corrections",
    "exactness",
    "evidence",
    "failure_modes"
  ],
  "properties": {
    "certificate_id": {"type": "string", "minLength": 1},
    "source_frame": {"type": "string", "minLength": 1},
    "target_frame": {"type": "string", "minLength": 1},
    "forward_map": {"type": "string", "minLength": 1},
    "inverse_map": {"type": ["string", "null"]},
    "validity_domain": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "preserved_invariants": {"type": "array", "items": {"type": "string"}},
    "transformed_quantities": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "frame_specific_quantities": {"type": "array", "items": {"type": "string"}},
    "discarded_information": {"type": "array", "items": {"type": "string"}},
    "reconstructible_information": {"type": "array", "items": {"type": "string"}},
    "known_corrections": {"type": "array", "items": {"type": "string"}},
    "exactness": {"$ref": "#/$defs/evidence_state"},
    "evidence": {"type": "object"},
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "evidence_state": {
      "enum": [
        "PROVEN",
        "FORMALLY_DERIVED",
        "EXACT_SYMBOLIC",
        "NUMERICALLY_REPRODUCED",
        "NUMERICALLY_SUPPORTED",
        "HEURISTIC",
        "CONJECTURAL",
        "DISPUTED",
        "CONTRADICTED",
        "PARTIAL",
        "BLOCKED"
      ]
    }
  }
}
