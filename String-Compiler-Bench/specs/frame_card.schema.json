{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stringbench/frame_card.schema.json",
  "title": "FrameCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_id",
    "theory",
    "spacetime_dimension",
    "supersymmetry",
    "background_geometry",
    "moduli",
    "fluxes",
    "branes",
    "charge_lattice",
    "gauge_data",
    "validity_domain",
    "approximation_order",
    "evidence"
  ],
  "properties": {
    "frame_id": {"type": "string", "minLength": 1},
    "theory": {"type": "string", "minLength": 1},
    "spacetime_dimension": {"type": "integer", "minimum": 1},
    "supersymmetry": {"type": "string", "minLength": 1},
    "background_geometry": {"type": "string", "minLength": 1},
    "moduli": {"type": "array", "items": {"type": "string"}},
    "fluxes": {"type": "array", "items": {"type": "string"}},
    "branes": {"type": "array", "items": {"type": "string"}},
    "charge_lattice": {"type": "string", "minLength": 1},
    "gauge_data": {"type": "object"},
    "validity_domain": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "approximation_order": {"type": "string", "minLength": 1},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sources", "scope", "assumptions", "limitations"],
      "properties": {
        "state": {"$ref": "#/$defs/evidence_state"},
        "sources": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"$ref": "#/$defs/source_ref"}
            ]
          }
        },
        "scope": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "url", "locator", "primary", "version"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "locator": {"type": "string", "minLength": 1},
        "primary": {"type": "boolean"},
        "version": {"type": ["string", "null"]}
      }
    },
    "evidence_state": {
      "enum": [
        "PROVEN",
        "FORMALLY_DERIVED",
        "EXACT_SYMBOLIC",
        "NUMERICALLY_REPRODUCED",
        "NUMERICALLY_SUPPORTED",
        "HEURISTIC",
        "CONJECTURAL",
        "DISPUTED",
        "CONTRADICTED",
        "PARTIAL",
        "BLOCKED"
      ]
    }
  }
}
