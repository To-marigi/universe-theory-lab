{"id":"claim:ads2_causal_order","claim":"The conformal factor does not change the causal order, so x precedes y iff t_x<t_y and |x_x-x_y|<t_y-t_x in the chart.","kind":"derivation","status":"FORMALLY_DERIVED","assumptions":["positive conformal factor","points remain inside the chart"],"scope":"AdS1+1 conformal coordinates","sources":[{"id":"arxiv:2504.12919v1","url":"https://arxiv.org/html/2504.12919v1","locator":"Eq. (9)"}],"depends_on":["claim:def_ads2_metric"]}
{"id":"claim:continuum_ads2_propagator","claim":"Inside the future light cone the retarded massive scalar Green function is (1/2) P_ell(cos(tau/L)), ell=(sqrt(1+4L^2m^2)-1)/2.","kind":"derivation","status":"FORMALLY_DERIVED","assumptions":["free scalar field","AdS1+1","retarded boundary condition","principal timelike geodesic domain"],"scope":"continuum calibration oracle","sources":[{"id":"arxiv:2504.12919v1","url":"https://arxiv.org/html/2504.12919v1","locator":"Eqs. (20)-(23)"}],"depends_on":["claim:def_ads2_metric"]}
{"id":"claim:discrete_path_sum","claim":"For a naturally labelled finite causal set, T=-(m^2/(2rho))A and a=-m^2/rho give K=(1/2)A(I+(m^2/(2rho))A)^(-1).","kind":"derivation","status":"FORMALLY_DERIVED","assumptions":["finite causal set","natural labelling","constant sprinkling density","alpha=-1 jump-amplitude choice"],"scope":"QG-Bench discrete scalar propagator","sources":[{"id":"arxiv:2504.12919v1","url":"https://arxiv.org/html/2504.12919v1","locator":"Eqs. (31)-(33), (52)-(56)"}],"depends_on":["claim:def_causal_set","claim:ads2_causal_order"]}
