{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qg-bench.local/schema/theory_card.schema.json",
  "title": "QG-Atlas TheoryCard v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "family",
    "fundamental_degrees_of_freedom",
    "state_space",
    "time_and_causality",
    "dynamics",
    "observables",
    "gauge_symmetry",
    "background_dependence",
    "continuum_limit",
    "general_relativity_recovery",
    "quantum_mechanics_recovery",
    "matter_inclusion",
    "black_hole_results",
    "cosmology_results",
    "proven",
    "numerical_evidence",
    "conjectures",
    "known_failures",
    "open_problems",
    "assumptions",
    "sources"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^theory:"},
    "name": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "fundamental_degrees_of_freedom": {"type": "array", "items": {"type": "string"}},
    "state_space": {"type": "array", "items": {"type": "string"}},
    "time_and_causality": {"type": "array", "items": {"type": "string"}},
    "dynamics": {"type": "array", "items": {"type": "string"}},
    "observables": {"type": "array", "items": {"type": "string"}},
    "gauge_symmetry": {"type": "array", "items": {"type": "string"}},
    "background_dependence": {"type": "array", "items": {"type": "string"}},
    "continuum_limit": {"type": "array", "items": {"type": "string"}},
    "general_relativity_recovery": {"type": "array", "items": {"type": "string"}},
    "quantum_mechanics_recovery": {"type": "array", "items": {"type": "string"}},
    "matter_inclusion": {"type": "array", "items": {"type": "string"}},
    "black_hole_results": {"type": "array", "items": {"type": "string"}},
    "cosmology_results": {"type": "array", "items": {"type": "string"}},
    "proven": {"type": "array", "items": {"type": "string"}},
    "numerical_evidence": {"type": "array", "items": {"type": "string"}},
    "conjectures": {"type": "array", "items": {"type": "string"}},
    "known_failures": {"type": "array", "items": {"type": "string"}},
    "open_problems": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "role"],
        "properties": {
          "id": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "role": {"type": "string"}
        }
      }
    }
  }
}
